<UserControl x:Class="NyvexGeneration.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NyvexGeneration.ViewModels">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageEnter}" />
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource TitleText}" Text="Dashboard" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,24"
                       Text="Visão geral da sessão atual: geração, consultas públicas e estado da conexão." />

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StatCard}">
                        <Border Style="{StaticResource CardBorder}" Width="196" Margin="0,0,16,16" Padding="18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource IconText}" FontSize="20"
                                           Foreground="{DynamicResource AccentGlowBrush}" Text="{Binding Glyph}" />
                                <TextBlock Margin="0,12,0,0" FontSize="30" FontWeight="Bold" Text="{Binding Value}" />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Title}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionText}" Text="Progresso em tempo real" />
                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentGlowBrush}"
                                   Text="{Binding State.ProgressPercent, StringFormat={}{0:0}%}" />
                    </Grid>

                    <ProgressBar Style="{StaticResource NeonProgressBar}" Margin="0,14,0,10"
                                 Value="{Binding State.ProgressPercent, Mode=OneWay}" />

                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding ProgressText}" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource MutedText}" Text="Tempo de execução" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding ElapsedText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource MutedText}" Text="Conexão com o Roblox" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{Binding State.Connection, Converter={StaticResource ConnectionBrush}}" />
                                <TextBlock Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold"
                                           Text="{Binding ConnectionText}" />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="0"
                                VerticalAlignment="Center" Content="Cancelar consulta"
                                Command="{Binding CancelCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource MutedText}" Text="{Binding LifetimeText}" Margin="2,0,0,12" />

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <TextBlock Style="{StaticResource MutedText}"
                           Text="Importante: &quot;Nenhuma correspondência&quot; significa apenas que a busca pública não retornou uma conta. Isso NÃO confirma que o username esteja livre para registro." />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
