<Window x:Class="NyvexGeneration.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NyvexGeneration.ViewModels"
        xmlns:v="clr-namespace:NyvexGeneration.Views"
        Title="NYVEX GENERATION"
        Width="1180" Height="720"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        SourceInitialized="Window_SourceInitialized">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <v:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GeneratorViewModel}">
            <v:GeneratorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultsViewModel}">
            <v:ResultsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <v:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="18,26,18,20">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,28">
                    <TextBlock Text="{Binding AppName}"
                               FontSize="30"
                               FontWeight="Black"
                               Foreground="{DynamicResource AccentGlowBrush}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#A855F7" BlurRadius="18" ShadowDepth="0" Opacity="0.6" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding AppSubtitle}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{Binding State.Connection, Converter={StaticResource ConnectionBrush}}" />
                        <TextBlock Margin="8,0,0,0" FontSize="12"
                                   Text="{Binding Dashboard.ConnectionText}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" FontSize="11"
                               Text="{Binding Version}"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <ListBox Style="{StaticResource NavListBox}"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" Width="22" />
                                <TextBlock Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1"
                        Margin="32,28,32,24"
                        Content="{Binding CurrentPage}"
                        IsTabStop="False" />
    </Grid>
</Window>
