<UserControl x:Class="NyvexGeneration.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageEnter}" />
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TitleText}" Text="Logs" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,16"
                       Text="Eventos do aplicativo. Credenciais e tokens nunca são registrados. Os arquivos ficam na pasta de dados." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <ListBox Style="{StaticResource ChipListBox}"
                         ItemsSource="{Binding Filters}"
                         SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                         DisplayMemberPath="Label" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Content="Copiar visíveis" Command="{Binding CopyVisibleCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="Abrir pasta de logs" Command="{Binding OpenFolderCommand}" />
                    <Button Style="{StaticResource DangerButton}" Content="Limpar visualização" Command="{Binding ClearCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource DarkDataGrid}" Margin="4"
                      CanUserSortColumns="False"
                      ItemsSource="{Binding View}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data e hora" Width="150"
                                        Binding="{Binding Timestamp, StringFormat='dd/MM/yyyy HH:mm:ss'}" />

                    <DataGridTemplateColumn Header="Gravidade" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Severity}"
                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Evento" Width="110" Binding="{Binding Category}" />

                    <DataGridTextColumn Header="Mensagem" Width="2*" Binding="{Binding Message}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding Message}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Detalhes técnicos" Width="1.5*" Binding="{Binding TechnicalDetails}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding TechnicalDetails}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
