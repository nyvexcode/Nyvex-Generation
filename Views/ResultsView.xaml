<UserControl x:Class="NyvexGeneration.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageEnter}" />
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TitleText}" Text="Resultados" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,16"
                       Text="Filtre, ordene, selecione, copie, favorite e exporte. Clique no cabeçalho de uma coluna para ordenar." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource MutedText}" Text="Pesquisar username" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource MutedText}" Text="Consulta individual" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource DarkTextBox}" Width="160" Margin="0,0,8,0" MaxLength="20"
                                     Text="{Binding SingleUsername, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CheckSingleCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Style="{StaticResource PrimaryButton}" Margin="0" Content="Consultar"
                                    Command="{Binding CheckSingleCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ListBox Style="{StaticResource ChipListBox}" Margin="0,14,0,0"
                         ItemsSource="{Binding Filters}"
                         SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                         DisplayMemberPath="Label" />

                <WrapPanel>
                    <Button Style="{StaticResource GhostButton}" Content="Selecionar visíveis" Command="{Binding SelectAllVisibleCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource GhostButton}" Content="Limpar seleção" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource GhostButton}" Content="Copiar selecionados" Command="{Binding CopySelectedCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource GhostButton}" Content="Favoritar selecionados" Command="{Binding FavoriteSelectedCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource GhostButton}" Content="Reconsultar selecionados" Command="{Binding RecheckSelectedCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource GhostButton}" Content="Consultar pendentes" Command="{Binding CheckPendingCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource GhostButton}" Content="Exportar TXT" Command="{Binding ExportTxtCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource GhostButton}" Content="Exportar CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource GhostButton}" Content="Cancelar consulta" Command="{Binding CancelCheckCommand}" Margin="0,0,8,8"
                            Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource DangerButton}" Content="Limpar tabela" Command="{Binding ClearResultsCommand}" Margin="0,0,8,8" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <DataGrid Style="{StaticResource DarkDataGrid}"
                          ItemsSource="{Binding View}"
                          Margin="4">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="48" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource DarkCheckBox}" HorizontalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="48" CanUserSort="True" SortMemberPath="IsFavorite">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButton}"
                                            Content="{Binding IsFavorite, Converter={StaticResource FavoriteGlyph}}"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Favoritar / desfavoritar" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Username" Width="1.2*" SortMemberPath="Username">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Text="{Binding Username}" />
                                        <Button Style="{StaticResource IconButton}" Margin="8,0,0,0" Content="&#xE8C8;"
                                                Command="{Binding DataContext.CopyUsernameCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Copiar username" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Comprimento" Width="110" Binding="{Binding Length}" SortMemberPath="Length" />

                        <DataGridTemplateColumn Header="Status" Width="1.3*" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Detalhes" Width="2.2*" Binding="{Binding Details}" SortMemberPath="Details">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Details}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Data da consulta" Width="170" Binding="{Binding CheckedAtText}" SortMemberPath="CheckedAt" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center"
                           Visibility="{Binding VisibleCount, Converter={StaticResource ZeroToVisible}}"
                           Text="Nenhum resultado para exibir. Gere usernames ou ajuste os filtros." />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="2,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding StatusMessage}" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                           Text="Nenhuma correspondência na busca pública NÃO significa que o username esteja livre." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding VisibleCount, StringFormat='Exibindo {0}'}" />
                <TextBlock Style="{StaticResource MutedText}" Margin="12,0,0,0"
                           Text="{Binding SelectedCount, StringFormat='{}{0} selecionado(s)'}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
